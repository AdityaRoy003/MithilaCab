{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        },
        "photoURL": {
            "type": "string",
            "format": "uri",
            "description": "URL of the user's profile picture."
        }
      },
      "required": ["uid", "name", "email"]
    },
    "Ride": {
        "title": "Ride",
        "description": "Represents a ride request and its details.",
        "type": "object",
        "properties": {
            "userId": {
                "type": "string"
            },
            "pickup": {
                "type": "string"
            },
            "destination": {
                "type": "string"
            },
            "fare": {
                "type": "number"
            },
            "status": {
                "type": "string",
                "enum": ["requested", "accepted", "inprogress", "completed", "cancelled"]
            },
            "driverId": {
                "type": "string"
            },
            "createdAt": {
                "type": "string",
                "format": "date-time"
            }
        },
        "required": ["userId", "pickup", "destination", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["anonymous", "google.com", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data, keyed by user ID."
    },
    "/rides/{rideId}": {
        "schema": {
            "$ref": "#/entities/Ride"
        },
        "description": "Stores ride details, keyed by a unique ride ID."
    }
  }
}
