rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user making the request is the owner of the document.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Ensures the document ID being written matches the user's auth UID.
    // This is used for creating user-owned documents like profiles.
    function isCreatingOwnDocument(docId) {
        return isOwner(docId);
    }

    // Ensures a field is not changed during an update.
    function isFieldImmutable(fieldName) {
      return request.resource.data[fieldName] == resource.data[fieldName];
    }
    
    // Validates that the incoming user data for creation is correct.
    function isValidUserCreate() {
        let data = request.resource.data;
        return data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['passenger', 'driver'];
    }
    
    // Validates that a user is only updating non-critical fields.
    function isValidUserUpdate() {
        let data = request.resource.data;
        return isFieldImmutable('id') &&
               isFieldImmutable('email') &&
               isFieldImmutable('role') &&
               isFieldImmutable('dateJoined');
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // A user can read their own profile.
      allow get: if isOwner(userId);

      // Only allow creating your own user document with valid data.
      allow create: if isCreatingOwnDocument(userId) && isValidUserCreate();
      
      // A user can update their own profile, but not change their ID, email, role, or join date.
      allow update: if isOwner(userId) && isValidUserUpdate();
      
      // No one can list all users or delete users for now to keep rules simple.
      allow list, delete: if false;
    }

    match /drivers/{driverId} {
      // Anyone signed in can view a driver's profile.
      allow get: if isSignedIn();
      
      // Drivers create their own profile.
      allow create: if isCreatingOwnDocument(driverId);
      
      // Drivers can update their own profile.
      allow update: if isOwner(driverId) && isFieldImmutable('id');
      
      // No one can list all drivers or delete drivers for now.
      allow list, delete: if false;
    }

    match /rides/{rideId} {
      // CRITICAL FIX: Allow a read if the user is the passenger, the driver,
      // or if the ride is unassigned. This is structured to be fast and
      // avoids the external lookups that caused previous failures.
      allow read: if isSignedIn() && (
                    request.auth.uid == resource.data.userId ||
                    request.auth.uid == resource.data.driverId ||
                    resource.data.driverId == null
                  );

      // A user can create a ride for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // A ride can be updated by the passenger who owns it, or by a driver accepting it.
      allow update: if isSignedIn() && (
                      (isOwner(resource.data.userId) && isFieldImmutable('userId')) ||
                      (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid)
                    );

      // Only the passenger can delete/cancel their own ride.
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
