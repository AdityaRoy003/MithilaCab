/**
 * # Firestore Security Rules
 *
 * ## Core Philosophy
 * This ruleset implements a strict ownership and shared-access model for a ride-sharing application.
 * User and Driver profiles are private and can only be modified by their owners.
 * Transactional data, like Rides, are shared documents accessible only by the specific participants (the user and the driver) involved in that transaction.
 * This ruleset follows the principle that "rules are not filters". Client-side queries MUST be constructed to only request data the user is permitted to see.
 *
 * ## Data Structure
 * - `/users/{userId}`: Private user profile data.
 * - `/drivers/{driverId}`: Publicly readable driver profile data, but only writable by the owner.
 * - `/rides/{rideId}`: Shared ride data, accessible only by the two participants.
 *
 * ## Key Security Decisions
 * - **Strict Ownership**: A user can only write to their own document in `/users/{userId}`.
 * - **Public Driver Profiles**: Any signed-in user can read driver profiles to see who is available, but only the driver can update their own profile.
 * - **No Public Listing of Users**: Listing all users is disallowed to protect privacy.
 * - **Shared Document Access**: Access to a `/rides/{rideId}` document is granted only if the requester's UID matches the `userId` or `driverId` field within that document.
 * - **Secure Listing of Rides**: The `list` rule for the `/rides` collection is intentionally broad (`if isSignedIn()`), but this is secure because the `get` rule (`if isRideParticipant()`) is checked on *every single document* returned by a query. This forces the client to build specific queries (e.g., `where('userId', '==', auth.uid)`) to avoid permission errors. An unconstrained query on `/rides` will always fail for a regular user, which is the desired secure behavior.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function canCreateOwnUserDoc(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }

    function canCreateOwnDriverDoc(driverId) {
      return isOwner(driverId) && request.resource.data.id == driverId;
    }

    function isIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Checks if the requesting user is either the customer (`userId`) or the
     * driver (`driverId`) for a specific ride document.
     * Also implicitly checks for authentication.
     */
    function isRideParticipant() {
      return isSignedIn() && resource != null && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.driverId);
    }

    function canCreateRide() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    function areRideParticipantsImmutable() {
      return request.resource.data.userId == resource.data.userId && request.resource.data.driverId == resource.data.driverId;
    }


    /**
     * @description Rules for the `users` collection. Only the owner can read or write their own data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow listing all users.
      allow create: if canCreateOwnUserDoc(userId);
      allow update: if isOwner(userId) && isIdImmutable();
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for the `drivers` collection. Profiles are public, but only the owner can write.
     */
    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if canCreateOwnDriverDoc(driverId);
      allow update: if isOwner(driverId) && isIdImmutable();
      allow delete: if isOwner(driverId);
    }

    /**
     * @description Rules for the `rides` collection. Shared access for participants.
     */
    match /rides/{rideId} {
      // A user can GET a ride document if they are a participant.
      allow get: if isRideParticipant();
      
      // A user can LIST rides if they are signed in.
      // THIS IS SECURE because Firestore also checks the `get` rule for each document.
      // A query for rides will FAIL unless the client adds a `where` clause to
      // only request rides where they are a participant.
      allow list: if isSignedIn();

      allow create: if canCreateRide();
      allow update: if isRideParticipant() && areRideParticipantsImmutable();
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
