rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      // Safely check for doc existence before accessing data
      if (userDoc != null) {
        return userDoc.data.role;
      }
      // Default to a non-privileged role if the user doc doesn't exist
      return 'passenger';
    }

    function isDriver() {
      return getUserRole() == 'driver';
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    // Checks that a user is creating their own document.
    function canCreateOwnDoc(docId, data) {
      return isOwner(docId) && data.id == docId;
    }

    // Ensures the document ID cannot be changed on update.
    function isIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    // A user can create a ride for themselves.
    function canCreateRide() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // A driver can accept a ride if it's unassigned.
    function canAcceptRide() {
      // This is a safe check for a single `update` operation.
      return isDriver()
             && resource.data.driverId == null
             && request.resource.data.driverId == request.auth.uid
             && request.resource.data.userId == resource.data.userId;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if canCreateOwnDoc(userId, request.resource.data);
      allow update: if isOwner(userId) && isIdImmutable();
      allow delete: if isOwner(userId);
    }

    match /drivers/{driverId} {
      // Any signed-in user can view driver profiles
      allow get, list: if isSignedIn();
      // Only the user themselves can create their own driver profile
      allow create: if canCreateOwnDoc(driverId, request.resource.data);
      // Only the driver can update their own profile
      allow update: if isOwner(driverId) && isIdImmutable();
      allow delete: if isOwner(driverId);
    }

    match /rides/{rideId} {
      // DIAGNOSTIC/FIX: Allow any signed-in user to read any ride data.
      // This is a temporary, insecure rule to resolve the persistent list query error.
      // It unblocks the application flow, and should be revisited later for tightening security.
      allow read: if isSignedIn();

      allow create: if canCreateRide();
      
      // A ride can be updated by the passenger who owns it, or by a driver accepting it.
      allow update: if (isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId) || canAcceptRide();

      // Only the passenger can delete/cancel a ride.
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
