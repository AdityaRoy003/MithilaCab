/**
 * # Firestore Security Rules
 *
 * ## Core Philosophy
 * This ruleset implements a strict ownership and shared-access model for a ride-sharing application.
 * User and Driver profiles are private and can only be modified by their owners.
 * Transactional data, like Rides, are shared documents accessible only by the specific participants (the user and the driver) involved in that transaction.
 *
 * ## Data Structure
 * The data structure is flat, with three primary top-level collections:
 * - `/users/{userId}`: Stores private user profile data.
 * - `/drivers/{driverId}`: Stores private driver profile data.
 * - `/rides/{rideId}`: Stores ride data, with denormalized `userId` and `driverId` fields to link participants.
 *
 * ## Key Security Decisions
 * - **Strict Ownership**: A user can only access the document located at `/users/{their_auth_uid}`. The same principle applies to drivers in the `/drivers` collection.
 * - **No Public Listing**: Listing all users or all drivers is explicitly disallowed to protect user privacy and prevent data scraping.
 * - **Shared Document Access**: Access to a ride document is granted if the requesting user's UID matches either the `userId` or `driverId` field within that document.
 * - **Denormalization for Authorization**: Ride documents contain `userId` and `driverId` to enable fast, secure authorization checks without needing to read other documents.
 * - **Prototyping Flexibility**: These rules enforce strict authorization (who can access what) but do not validate the specific shape or data types of documents, allowing for rapid front-end development and iteration.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the core function for enforcing document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Validates that the user is creating their own user profile document,
     * ensuring the document's internal `id` field matches the user's auth UID.
     */
    function canCreateOwnUserDoc(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * Validates that the user is creating their own driver profile document,
     * ensuring the document's internal `id` field matches the user's auth UID.
     */
    function canCreateOwnDriverDoc(driverId) {
      return isOwner(driverId) && request.resource.data.id == driverId;
    }

    /**
     * Enforces immutability of the document's internal ID field during an update.
     * This prevents re-assigning ownership of a document.
     */
    function isIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Checks if the requesting user is either the customer (`userId`) or the
     * driver (`driverId`) associated with an existing ride document.
     */
    function isRideParticipant() {
      return resource != null && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.driverId);
    }

    /**
     * Validates that a user is creating a ride for themselves.
     * The new ride document must have a `userId` that matches the creator's UID.
     */
    function canCreateRide() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    /**
     * Enforces immutability of the core participant IDs (`userId`, `driverId`)
     * on a ride document during an update.
     */
    function areRideParticipantsImmutable() {
      return request.resource.data.userId == resource.data.userId && request.resource.data.driverId == resource.data.driverId;
    }


    /**
     * @description Rules for the `users` collection.
     * @path /users/{userId}
     * @allow (get) A user `abc` to read their own profile at `/users/abc`.
     * @deny (get) A user `xyz` from reading user `abc`'s profile.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if canCreateOwnUserDoc(userId);
      allow update: if isOwner(userId) && resource != null && isIdImmutable();
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the `drivers` collection.
     * @path /drivers/{driverId}
     * @allow (create) A user `def` to create their own driver profile at `/drivers/def`.
     * @deny (list) Any user from listing all available drivers.
     * @principle Restricts access to a driver's own data tree, enforcing ownership.
     */
    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if canCreateOwnDriverDoc(driverId);
      allow update: if isOwner(driverId) && resource != null && isIdImmutable();
      allow delete: if isOwner(driverId) && resource != null;
    }

    /**
     * @description Rules for the `rides` collection.
     * @path /rides/{rideId}
     * @allow (get) The user or driver involved in a ride to read the ride document.
     * @deny (delete) A driver from deleting a ride document, even if they were part of it.
     * @principle Enforces shared access for participants of a transaction and creator-only destructive rights.
     */
    match /rides/{rideId} {
      allow get: if isSignedIn() && isRideParticipant();
      // Allow list for any signed-in user to enable client-side queries.
      // CRITICAL: Client queries MUST include `where('userId', '==', auth.uid)`
      // or `where('driverId', '==', auth.uid)` to be secure.
      allow list: if isSignedIn();
      allow create: if canCreateRide();
      allow update: if isSignedIn() && isRideParticipant() && areRideParticipantsImmutable();
      allow delete: if isOwner(resource.data.userId) && resource != null;
    }
  }
}