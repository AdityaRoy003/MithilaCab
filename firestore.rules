rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSuperAdmin() {
      // Super-admin by email address always has access.
      return request.auth != null && request.auth.token.email == 'mithila@cabadmingmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isFieldImmutable(fieldName) {
      // This function can only be used in 'update' rules.
      return request.resource.data[fieldName] == resource.data[fieldName];
    }
    
    function isValidUserCreate() {
        let data = request.resource.data;
        return data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['passenger', 'driver'];
    }
    
    function isValidUserUpdate() {
        let data = request.resource.data;
        return isFieldImmutable('id') &&
               isFieldImmutable('email') &&
               isFieldImmutable('role') &&
               isFieldImmutable('dateJoined');
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow create: if (isOwner(userId) && isValidUserCreate()) || isSuperAdmin();
      allow update: if (isOwner(userId) && isValidUserUpdate()) || isSuperAdmin();
      allow list, delete: if isSuperAdmin();

      match /transactions/{transactionId} {
        allow read, list: if isOwner(userId) || isSuperAdmin();
        allow create: if isOwner(userId) || isSuperAdmin();
        allow update, delete: if false;
      }
    }

    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow create: if isOwner(driverId);
      allow update: if (isOwner(driverId) && isFieldImmutable('id')) || isSuperAdmin();
      allow list, delete: if isSuperAdmin();
    }

    match /rides/{rideId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
                      (isOwner(resource.data.userId) && isFieldImmutable('userId')) ||
                      (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid) ||
                      (isOwner(resource.data.driverId) && isFieldImmutable('userId') && isFieldImmutable('driverId')) ||
                      isSuperAdmin()
                    );
      allow delete: if isOwner(resource.data.userId) || isSuperAdmin();
    }
    
    match /incentives/{incentiveId} {
      allow read, list: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /roles/{roleId} {
      allow read, list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    
    match /refunds/{refundId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}
