rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user making the request is the owner of the document.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Generic permission checker. This is the new source of truth for authorization.
    function hasPermission(permission) {
      // User must be signed in.
      if (request.auth == null) {
        return false;
      }

      // The user's profile document must exist.
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      if (!exists(userDocPath)) {
        return false;
      }
      
      let userData = get(userDocPath).data;

      // The user must have a role assigned.
      if (!('role' in userData)) {
        return false;
      }
      let userRole = userData.role;

      // Legacy 'admin' string role gets all permissions.
      if (userRole == 'admin') {
        return true;
      }

      if (!(userRole is string)) {
          return false;
      }
      
      // For document-based roles, the role document must exist.
      let roleDocPath = /databases/$(database)/documents/roles/$(userRole);
      if (!exists(roleDocPath)) {
        return false;
      }
      
      let roleData = get(roleDocPath).data;
      
      // The role document must have a 'permissions' list.
      if (!('permissions' in roleData) || !(roleData.permissions is list)) {
          return false;
      }
      
      // Check if the required permission or 'admin.full_access' is in the list.
      return roleData.permissions.hasAny([permission, 'admin.full_access']);
    }

    // Ensures the document ID being written matches the user's auth UID.
    // This is used for creating user-owned documents like profiles.
    function isCreatingOwnDocument(docId) {
        return isOwner(docId);
    }

    // Ensures a field is not changed during an update.
    function isFieldImmutable(fieldName) {
      return request.resource.data[fieldName] == resource.data[fieldName];
    }
    
    // Validates that the incoming user data for creation is correct.
    function isValidUserCreate() {
        let data = request.resource.data;
        return data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['passenger', 'driver'];
    }
    
    // Validates that a user is only updating non-critical fields.
    function isValidUserUpdate() {
        let data = request.resource.data;
        return isFieldImmutable('id') &&
               isFieldImmutable('email') &&
               isFieldImmutable('role') &&
               isFieldImmutable('dateJoined');
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // A user can read their own profile. Staff can read any profile.
      allow get: if isOwner(userId) || hasPermission('users.manage');

      // Allow creating own user document (passenger/driver) or if an admin is creating a staff member.
      allow create: if (isCreatingOwnDocument(userId) && isValidUserCreate()) || hasPermission('admin.full_access');
      
      // A user can update their own profile. Staff can update any.
      allow update: if (isOwner(userId) && isValidUserUpdate()) || hasPermission('users.manage');
      
      // Staff with 'users.manage' permission can list and delete users.
      allow list: if hasPermission('users.manage');
      allow delete: if hasPermission('users.manage');

      match /transactions/{transactionId} {
        // A user can read their own transactions. Staff with finance perms can read any.
        allow read, list: if isOwner(userId) || hasPermission('finance.view');
        
        // A user can create a transaction for themselves (e.g., top-up).
        // Staff can create transactions like refunds.
        allow create: if isOwner(userId) || hasPermission('finance.manage');
        
        // Transactions are immutable once created to maintain financial integrity.
        allow update, delete: if false;
      }
    }

    match /drivers/{driverId} {
      // Anyone signed in can view a driver's profile.
      allow get: if isSignedIn();
      
      // Drivers create their own profile.
      allow create: if isCreatingOwnDocument(driverId);
      
      // Drivers can update their own profile. Staff can also update driver profiles.
      allow update: if (isOwner(driverId) && isFieldImmutable('id')) || hasPermission('drivers.manage');
      
      // Staff can list and delete drivers.
      allow list, delete: if hasPermission('drivers.manage');
    }

    match /rides/{rideId} {
      // A user can read a single ride if they are the passenger, the driver, or staff.
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || hasPermission('rides.monitor'));
      
      // Only staff can query the entire rides collection.
      allow list: if exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                     (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || hasPermission('rides.monitor'));

      // A user can create a ride request for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // A ride can be updated by passengers, drivers under certain conditions, or by staff.
      allow update: if isSignedIn() && (
                      (isOwner(resource.data.userId) && isFieldImmutable('userId')) ||
                      (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid) ||
                      (isOwner(resource.data.driverId) && isFieldImmutable('userId') && isFieldImmutable('driverId')) ||
                      hasPermission('rides.monitor') // Staff with monitor perms can update (e.g. assign driver)
                    );

      // The passenger can delete their ride, or staff can.
      allow delete: if isOwner(resource.data.userId) || hasPermission('rides.monitor');
    }
    
    match /incentives/{incentiveId} {
      // Staff with finance perms can create, update, and delete incentives.
      allow write: if hasPermission('finance.manage');
      
      // All signed-in users (including drivers) can read and list incentives.
      allow get, list: if isSignedIn();
    }

    match /settings/{settingId} {
      // All signed-in users can read platform settings for fare calculation.
      allow read: if isSignedIn();
      // Only staff with settings perms can write platform settings.
      allow write: if hasPermission('settings.manage');
    }

    match /roles/{roleId} {
      // Any staff member can read roles to understand permissions.
      allow read, list: if hasPermission('admin.full_access') || hasPermission('users.manage');
      // Only full admins can create, update, or delete roles.
      allow write: if hasPermission('admin.full_access');
    }
    
    match /refunds/{refundId} {
      // A user can create a refund request for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // A user can read their own refund requests. Support staff can read any.
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || hasPermission('support.access'));
      allow list: if hasPermission('support.access');

      // Only support staff can update (approve/deny) a refund request.
      allow update: if hasPermission('support.access');

      // Only full admins can delete.
      allow delete: if hasPermission('admin.full_access');
    }
  }
}
