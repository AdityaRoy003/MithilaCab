rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Checks a user's role from their user document.
    // IMPORTANT: This should not be used in 'list' query rules for performance reasons.
    function isRole(role) {
        return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    function isDriver() {
        return isRole('driver');
    }
    
    function isAdmin() {
        return isRole('admin');
    }
    
    // Checks that a user is creating their own document.
    function canCreateOwnDoc(docId) {
      return isOwner(docId);
    }

    // Ensures the document ID cannot be changed on update.
    function isIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    // A user can create a ride for themselves.
    function canCreateRide() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // A driver can accept a ride if it's unassigned.
    function canAcceptRide() {
      return isDriver()
             && resource.data.driverId == null
             && request.resource.data.driverId == request.auth.uid
             && request.resource.data.userId == resource.data.userId;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if canCreateOwnDoc(userId);
      allow update: if isOwner(userId) && isIdImmutable();
      allow delete: if isOwner(userId);
    }

    match /drivers/{driverId} {
      // Any signed-in user can view driver profiles (for ride details)
      allow get: if isSignedIn();
      // Listing all drivers is an admin function.
      allow list: if isAdmin();
      // Only the user themselves can create their own driver profile
      allow create: if canCreateOwnDoc(driverId);
      // Only the driver can update their own profile
      allow update: if isOwner(driverId) && isIdImmutable();
      allow delete: if isOwner(driverId);
    }

    match /rides/{rideId} {
      // STABILITY FIX: Allow any signed-in user to read ride data.
      // This is the simplest possible rule to resolve all list query errors.
      allow get, list: if isSignedIn();

      allow create: if canCreateRide();
      
      // A ride can be updated by the passenger who owns it, or by a driver accepting it.
      allow update: if (isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId) || canAcceptRide();

      // Only the passenger can delete/cancel a ride.
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
