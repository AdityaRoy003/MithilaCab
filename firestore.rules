rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user making the request is the owner of the document.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Ensures the document ID being written matches the user's auth UID.
    // This is used for creating user-owned documents like profiles.
    function isCreatingOwnDocument(docId) {
        return isOwner(docId);
    }

    // Ensures a field is not changed during an update.
    function isFieldImmutable(fieldName) {
      return request.resource.data[fieldName] == resource.data[fieldName];
    }
    
    // Validates that the incoming user data for creation is correct.
    function isValidUserCreate() {
        let data = request.resource.data;
        return data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['passenger', 'driver', 'admin'];
    }
    
    // Validates that a user is only updating non-critical fields.
    function isValidUserUpdate() {
        let data = request.resource.data;
        return isFieldImmutable('id') &&
               isFieldImmutable('email') &&
               isFieldImmutable('role') &&
               isFieldImmutable('dateJoined');
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // A user can read their own profile.
      allow get: if isOwner(userId);

      // Only allow creating your own user document with valid data.
      allow create: if isCreatingOwnDocument(userId) && isValidUserCreate();
      
      // A user can update their own profile, but not change their ID, email, role, or join date.
      allow update: if isOwner(userId) && isValidUserUpdate();
      
      // For now, only admins will be able to list users, which we will implement later.
      allow list, delete: if false;
    }

    match /drivers/{driverId} {
      // Anyone signed in can view a driver's profile. This is needed for passengers to see driver info.
      allow get: if isSignedIn();
      
      // Drivers create their own profile.
      allow create: if isCreatingOwnDocument(driverId);
      
      // Drivers can update their own profile.
      allow update: if isOwner(driverId) && isFieldImmutable('id');
      
      // For now, only admins will be able to list drivers, which we will implement later.
      allow list, delete: if false;
    }

    match /rides/{rideId} {
      // GET: A user can read a single ride document if they are the passenger or the driver.
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid);
      
      // LIST: Any signed-in user can query the rides collection.
      // This is safe because client-side queries are constrained to only request data
      // the user is supposed to see (e.g., where userId == auth.uid for passengers,
      // or where driverId == null for drivers). This permissive 'list' rule is necessary
      // because Firestore rules cannot inspect query 'where' clauses directly for non-trivial queries.
      // The 'get' rule above still secures direct document access by ID.
      allow list: if isSignedIn();

      // CREATE: A user can create a ride request for themselves.
      // The userId in the new document must match their own auth uid.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // UPDATE: A ride can be updated by several parties based on specific conditions.
      allow update: if isSignedIn() && (
                      // The passenger can update their own ride (e.g., to cancel it), but cannot change the owner.
                      (isOwner(resource.data.userId) && isFieldImmutable('userId')) ||
                      // A driver can accept an unassigned ride by setting themselves as the driver.
                      (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid) ||
                      // The assigned driver can update the ride (e.g., to change status), but cannot reassign it or change the passenger.
                      (isOwner(resource.data.driverId) && isFieldImmutable('userId') && isFieldImmutable('driverId'))
                    );

      // DELETE: Only the passenger can delete/cancel their own ride.
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
