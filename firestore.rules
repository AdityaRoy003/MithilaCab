rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user making the request is the owner of the document.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Checks if the requesting user has an 'admin' role.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Checks if the requesting user has a 'support' role.
    function isSupport() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'support';
    }

    // Ensures the document ID being written matches the user's auth UID.
    // This is used for creating user-owned documents like profiles.
    function isCreatingOwnDocument(docId) {
        return isOwner(docId);
    }

    // Ensures a field is not changed during an update.
    function isFieldImmutable(fieldName) {
      return request.resource.data[fieldName] == resource.data[fieldName];
    }
    
    // Validates that the incoming user data for creation is correct.
    function isValidUserCreate() {
        let data = request.resource.data;
        return data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['passenger', 'driver'];
    }
    
    // Validates that a user is only updating non-critical fields.
    function isValidUserUpdate() {
        let data = request.resource.data;
        return isFieldImmutable('id') &&
               isFieldImmutable('email') &&
               isFieldImmutable('role') &&
               isFieldImmutable('dateJoined');
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // A user can read their own profile. Admins and Support can read any profile.
      allow get: if isOwner(userId) || isAdmin() || isSupport();

      // Only allow creating your own user document with valid data.
      allow create: if isCreatingOwnDocument(userId) && isValidUserCreate();
      
      // A user can update their own profile (but not role). Admins can update anything.
      // Support can update users (but not admins) and cannot change roles.
      allow update: if (isOwner(userId) && isValidUserUpdate()) || isAdmin() || (isSupport() && isValidUserUpdate() && resource.data.role != 'admin');
      
      // Admins and Support can list users. Only Admins can delete.
      allow list: if isAdmin() || isSupport();
      allow delete: if isAdmin();

      match /transactions/{transactionId} {
        // A user can read their own transactions. Admins can read any.
        allow read, list: if isOwner(userId) || isAdmin();
        
        // A user can create a transaction for themselves (e.g., top-up).
        allow create: if isOwner(userId);
        
        // Transactions are immutable once created to maintain financial integrity.
        allow update, delete: if false;
      }
    }

    match /drivers/{driverId} {
      // Anyone signed in can view a driver's profile.
      allow get: if isSignedIn();
      
      // Drivers create their own profile.
      allow create: if isCreatingOwnDocument(driverId);
      
      // Drivers can update their own profile. Admins can also update driver profiles.
      allow update: if (isOwner(driverId) && isFieldImmutable('id')) || isAdmin();
      
      // Admins can list and delete drivers.
      allow list, delete: if isAdmin();
    }

    match /rides/{rideId} {
      // GET: A user can read a single ride document if they are the passenger, the driver, or an admin/support staff.
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin() || isSupport());
      
      // LIST: Any signed-in user can query the rides collection.
      // Client-side queries should enforce further constraints.
      allow list: if isSignedIn();

      // CREATE: A user can create a ride request for themselves.
      // The userId in the new document must match their own auth uid.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // UPDATE: A ride can be updated by passengers, drivers under certain conditions, or by an admin.
      allow update: if isSignedIn() && (
                      // The passenger can update their own ride (e.g., to cancel it), but cannot change the owner.
                      (isOwner(resource.data.userId) && isFieldImmutable('userId')) ||
                      // A driver can accept an unassigned ride by setting themselves as the driver.
                      (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid) ||
                      // The assigned driver can update the ride (e.g., to change status), but cannot reassign it or change the passenger.
                      (isOwner(resource.data.driverId) && isFieldImmutable('userId') && isFieldImmutable('driverId')) ||
                      // An admin can update any ride.
                      isAdmin()
                    );

      // DELETE: The passenger can delete their ride, or an admin can.
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    match /incentives/{incentiveId} {
      // Admins can create, update, and delete incentives.
      allow write: if isAdmin();
      
      // All signed-in users (including drivers) can read and list incentives.
      allow get, list: if isSignedIn();
    }

    match /settings/{settingId} {
      // All signed-in users can read platform settings for fare calculation.
      allow read: if isSignedIn();
      // Only admins can write platform settings.
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      // Any signed-in staff member can read roles to understand permissions.
      allow read, list: if isSignedIn();
      // Only admins can create, update, or delete roles.
      allow write: if isAdmin();
    }
  }
}
