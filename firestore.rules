rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function can(permission) {
      // 1. Super-admin by email address always has access.
      if (request.auth != null && request.auth.token.email == 'mithila@cabadmingmail.com') {
        return true;
      }
      
      // 2. Check for user profile document for role-based access.
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      if (!exists(userDocPath)) {
        return false;
      }
      
      let userRole = get(userDocPath).data.get('role', null);
      
      // 3. Handle legacy 'admin' string role for backward compatibility.
      if (userRole == 'admin') {
          return true;
      }

      // 4. Handle document-based roles for other staff.
      if (userRole is string && !(userRole in ['passenger', 'driver', 'admin'])) {
        let roleDocPath = /databases/$(database)/documents/roles/$(userRole);
        if (exists(roleDocPath)) {
          let roleData = get(roleDocPath).data;
          if ('permissions' in roleData && roleData.permissions is list) {
            // Check for the specific permission or a full admin access permission.
            return permission in roleData.permissions || 'admin.full_access' in roleData.permissions;
          }
        }
      }
      
      // 5. Deny access if no valid permission found.
      return false;
    }

    function isFieldImmutable(fieldName) {
      // This function can only be used in 'update' rules.
      return request.resource.data[fieldName] == resource.data[fieldName];
    }
    
    function isValidUserCreate() {
        let data = request.resource.data;
        return data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['passenger', 'driver'];
    }
    
    function isValidUserUpdate() {
        let data = request.resource.data;
        return isFieldImmutable('id') &&
               isFieldImmutable('email') &&
               isFieldImmutable('role') &&
               isFieldImmutable('dateJoined');
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || can('users.manage');
      allow create: if (isOwner(userId) && isValidUserCreate()) || can('admin.full_access');
      allow update: if (isOwner(userId) && isValidUserUpdate()) || can('users.manage');
      allow list, delete: if can('users.manage');

      match /transactions/{transactionId} {
        allow read, list: if isOwner(userId) || can('finance.view');
        allow create: if isOwner(userId) || can('finance.manage');
        allow update, delete: if false;
      }
    }

    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow create: if isOwner(driverId);
      allow update: if (isOwner(driverId) && isFieldImmutable('id')) || can('drivers.manage');
      allow list, delete: if can('drivers.manage');
    }

    match /rides/{rideId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || can('rides.monitor'));
      allow list: if can('rides.monitor') || can('support.access');
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
                      (isOwner(resource.data.userId) && isFieldImmutable('userId')) ||
                      (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid) ||
                      (isOwner(resource.data.driverId) && isFieldImmutable('userId') && isFieldImmutable('driverId')) ||
                      can('rides.monitor')
                    );
      allow delete: if isOwner(resource.data.userId) || can('rides.monitor');
    }
    
    match /incentives/{incentiveId} {
      allow read, list: if isSignedIn();
      allow write: if can('finance.manage');
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if can('settings.manage');
    }

    match /roles/{roleId} {
      allow read, list: if can('users.manage');
      allow write: if can('admin.full_access');
    }
    
    match /refunds/{refundId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || can('support.access'));
      allow list, update: if can('support.access');
      allow delete: if can('admin.full_access');
    }
  }
}
