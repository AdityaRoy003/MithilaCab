rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global rule: Grant full access ONLY to the Super Admin.
    // This is a temporary and broad rule to definitively solve the admin permission issue.
    // All other users are denied access until security is re-layered.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'mithila@cabadmingmail.com';
    }
  }
}
