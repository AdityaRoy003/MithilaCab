rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This is a temporary, insecure rule for diagnostics.
    // It grants the admin full access to everything, and blocks everyone else.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'mithila@cabadmingmail.com';
    }
  }
}
