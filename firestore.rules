rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSuperAdmin() {
      // Super-admin by email address always has access.
      return request.auth != null && request.auth.token.email == 'mithila@cabadmingmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function hasPermission(permission) {
      // This function checks for permissions based on role documents for non-super-admins.
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      
      // 1. User must have a profile.
      if (!exists(userDocPath)) {
        return false;
      }
      
      let userProfile = get(userDocPath).data;
      let userRole = userProfile.get('role', null);

      // 2. User must have a role that points to a document.
      if (userRole == null || userRole in ['passenger', 'driver', 'admin']) {
        return false;
      }

      // 3. The role document must exist.
      let roleDocPath = /databases/$(database)/documents/roles/$(userRole);
      if (!exists(roleDocPath)) {
        return false;
      }

      // 4. The role document must have a list of permissions.
      let roleData = get(roleDocPath).data;
      if (!('permissions' in roleData) || !(roleData.permissions is list)) {
        return false;
      }
      
      // 5. Check for the specific permission or a full admin access permission.
      return permission in roleData.permissions || 'admin.full_access' in roleData.permissions;
    }

    function isFieldImmutable(fieldName) {
      // This function can only be used in 'update' rules.
      return request.resource.data[fieldName] == resource.data[fieldName];
    }
    
    function isValidUserCreate() {
        let data = request.resource.data;
        return data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['passenger', 'driver'];
    }
    
    function isValidUserUpdate() {
        let data = request.resource.data;
        return isFieldImmutable('id') &&
               isFieldImmutable('email') &&
               isFieldImmutable('role') &&
               isFieldImmutable('dateJoined');
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin() || hasPermission('users.manage');
      allow create: if (isOwner(userId) && isValidUserCreate()) || isSuperAdmin();
      allow update: if (isOwner(userId) && isValidUserUpdate()) || isSuperAdmin() || hasPermission('users.manage');
      allow list, delete: if isSuperAdmin() || hasPermission('users.manage');

      match /transactions/{transactionId} {
        allow read, list: if isOwner(userId) || isSuperAdmin() || hasPermission('finance.view');
        allow create: if isOwner(userId) || isSuperAdmin() || hasPermission('finance.manage');
        allow update, delete: if false;
      }
    }

    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow create: if isOwner(driverId);
      allow update: if (isOwner(driverId) && isFieldImmutable('id')) || isSuperAdmin() || hasPermission('drivers.manage');
      allow list, delete: if isSuperAdmin() || hasPermission('drivers.manage');
    }

    match /rides/{rideId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || isSuperAdmin() || hasPermission('rides.monitor'));
      allow list: if isSuperAdmin() || hasPermission('rides.monitor') || hasPermission('support.access');
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
                      (isOwner(resource.data.userId) && isFieldImmutable('userId')) ||
                      (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid) ||
                      (isOwner(resource.data.driverId) && isFieldImmutable('userId') && isFieldImmutable('driverId')) ||
                      isSuperAdmin() || hasPermission('rides.monitor')
                    );
      allow delete: if isOwner(resource.data.userId) || isSuperAdmin() || hasPermission('rides.monitor');
    }
    
    match /incentives/{incentiveId} {
      allow read, list: if isSignedIn();
      allow write: if isSuperAdmin() || hasPermission('finance.manage');
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || hasPermission('settings.manage');
    }

    match /roles/{roleId} {
      allow read, list: if isSuperAdmin() || hasPermission('users.manage');
      allow write: if isSuperAdmin();
    }
    
    match /refunds/{refundId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin() || hasPermission('support.access'));
      allow list, update: if isSuperAdmin() || hasPermission('support.access');
      allow delete: if isSuperAdmin();
    }
  }
}
